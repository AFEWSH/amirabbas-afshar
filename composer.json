{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "amirabbas/personal-portfolio",
  "type": "project",
  "license": "proprietary",
  "require": {"php": "^8.3", "laravel/framework": "^13.0", "livewire/livewire": "^4.0", "filament/filament": "^5.0"},
  "require-dev": {"fakerphp/faker": "^1.24", "laravel/pint": "^1.0", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.0", "phpunit/phpunit": "^12.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
